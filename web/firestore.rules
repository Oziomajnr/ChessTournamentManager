rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{shareCode} {
      // Anyone can read tournament data (for the web viewer)
      allow read: if true;

      // Writes require a valid writeKey embedded in the document.
      // The key is injected from local.properties into the Android app at build time.
      // It never appears in the web viewer or any client-facing code.
      // Replace YOUR_WRITE_KEY with the same value as firebase.writeKey in local.properties (Android).
      allow create: if request.resource.data.writeKey == "YOUR_WRITE_KEY";
      allow update: if request.resource.data.writeKey == "YOUR_WRITE_KEY";

      // Deletes are not allowed
      allow delete: if false;
    }

    // Deny all access to any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
