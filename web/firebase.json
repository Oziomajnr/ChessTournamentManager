  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/t/**", "destination": "/index.html" },
      { "source": "/privacy", "destination": "/privacy.html" }
